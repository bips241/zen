<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust all certificates in debug builds (emulator DNS issues) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow R2 CDN domain -->
    <domain-config>
        <domain includeSubdomains="true">r2.dev</domain>
        <domain includeSubdomains="true">cloudflare.com</domain>
        <domain includeSubdomains="true">cloudflarestorage.com</domain>
    </domain-config>
</network-security-config>
