{
  "name": "focusshell",
  "displayName": "FocusShell",
  "expo": {
    "name": "FocusShell",
    "slug": "focusshell",
    "version": "0.1.0",
    "platforms": ["android"],
    "sdkVersion": "48.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/ZEN.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.anonymous.focusshell",
      "icon": "./src/assets/ZEN.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/ZEN.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "navigationBarColor": "#00000000",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "position": "absolute"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "829597e0-b63d-494b-a63e-9ee2a021db6b"
      }
    }
  }
}
